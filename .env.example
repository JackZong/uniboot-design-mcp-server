# UniBoot Design MCP
# Production public URL is https://mcp.ubd.paxcq.com (not the web origin).
MCP_PORT=8070
MCP_HOST=0.0.0.0
MCP_PUBLIC_URL=http://localhost:8070
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional PKCS#8 PEM for stable OIDC JWKS across restarts (Cursor metadata).
# If unset, a fresh RSA key is generated at process start.
# MCP_OAUTH_JWKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# UniBoot Design API (login + tools)
UBD_API_BASE=http://localhost:8060/api/v1
UBD_WEB_BASE=http://localhost:5173
