{
  "name": "uniboot-design-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official remote MCP server for UniBoot Design. Connect Cursor and other AI tools to your designs via OAuth 2.1.",
  "bin": {
    "uniboot-design-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
